{
  "expo": {
    "name": "Limkokwing Reporting System",
    "slug": "limkokwing-reporting-system",
    "version": "1.0.0",
    "orientation": "portrait",
      "userInterfaceStyle": "dark",
    "platforms": ["ios", "android", "web"],
    "icon": "./assets/images/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0f1220"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
